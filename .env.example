# Copia este archivo a .env.local y rellena los valores reales.
# .env.local es gitignored.

# --- Groq API (LLM provider) ---
# Crea una API key gratis en https://console.groq.com/keys
# Free tier sin tarjeta: 30 RPM / 6K TPM / 1,000 RPD
GROQ_API_KEY=

# --- Daily token budget ---
# Corta el servicio si excede este budget al día (protección de costo)
AI_AGENT_DAILY_TOKEN_BUDGET=200000

# --- Security API base URL ---
# Endpoint del backend de security.lalu.dev que las tools consultan
# Si corres este agent en otra infra, apunta a tu propio endpoint
SECURITY_API_BASE=https://security.lalu.dev/api
